<mxfile host="app.diagrams.net">
  <diagram id="edge-core-arch" name="Edge + Core Architecture">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;Alarm Flood Triage&lt;/b&gt; — Decide at the Edge (Strands Decider 2B), Generate in the Core (Amazon Bedrock)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="20" y="0" width="1100" height="40" as="geometry" />
        </mxCell>

        <!-- ===================== EDGE ===================== -->
        <mxCell id="grpEdge" value="Factory Edge — Your Laptop (WSL2 Ubuntu · RTX 4050)" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_corporate_data_center;strokeColor=#7D8998;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#5A6C86;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="80" width="380" height="560" as="geometry" />
        </mxCell>

        <mxCell id="decider" value="&lt;b&gt;Strands Decider 2B&lt;/b&gt;&lt;br&gt;strands-decider serve (localhost:8099)&lt;br&gt;4 yes/no signals per alarm, scoped state&lt;br&gt;danger · consequence · noise · maintenance&lt;br&gt;~0.9 s on a laptop RTX 4050" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="300" height="110" as="geometry" />
        </mxCell>

        <mxCell id="edgeAgent" value="&lt;b&gt;Edge Triage Agent (Python)&lt;/b&gt;&lt;br&gt;• AWS IoT Device SDK v2 + X.509 cert&lt;br&gt;• rolling state: last 20 alarms + operator log + topology&lt;br&gt;• PolicyGate (Decider) → Router&lt;br&gt;• route: suppress / review / escalate&lt;br&gt;• heartbeat: edge/{id}/status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;align=left;spacingLeft=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="310" width="300" height="160" as="geometry" />
        </mxCell>

        <mxCell id="edgeNote" value="Outbound-only connection · no open ports · no tunnel&lt;br&gt;(mirrors IEC 62443 / Purdue-model OT segmentation)" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5A6C86;fontStyle=2;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="340" height="60" as="geometry" />
        </mxCell>

        <mxCell id="user" value="Operator / Judge&lt;br&gt;(web browser)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.user;" vertex="1" parent="1">
          <mxGeometry x="170" y="740" width="78" height="78" as="geometry" />
        </mxCell>

        <!-- ===================== AWS CLOUD ===================== -->
        <mxCell id="grpCloud" value="AWS Cloud (Core)" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="440" y="40" width="1220" height="920" as="geometry" />
        </mxCell>

        <mxCell id="grpRegion" value="Region: us-east-1" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="80" width="1180" height="860" as="geometry" />
        </mxCell>

        <!-- Row: messaging + incident pipeline -->
        <mxCell id="iot" value="&lt;b&gt;AWS IoT Core&lt;/b&gt;&lt;br&gt;MQTT broker · Thing + cert&lt;br&gt;IoT Rules" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.iot_core;" vertex="1" parent="1">
          <mxGeometry x="600" y="330" width="78" height="78" as="geometry" />
        </mxCell>

        <mxCell id="ddbAlarms" value="&lt;b&gt;Amazon DynamoDB&lt;/b&gt;&lt;br&gt;alarms + decisions" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="830" y="140" width="78" height="78" as="geometry" />
        </mxCell>

        <mxCell id="sqs" value="&lt;b&gt;Amazon SQS&lt;/b&gt;&lt;br&gt;escalations (+ DLQ)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="1">
          <mxGeometry x="830" y="330" width="78" height="78" as="geometry" />
        </mxCell>

        <mxCell id="lambda" value="&lt;b&gt;AWS Lambda&lt;/b&gt;&lt;br&gt;Incident grouper" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="1040" y="330" width="78" height="78" as="geometry" />
        </mxCell>

        <mxCell id="agent" value="&lt;b&gt;Strands Agent&lt;/b&gt;&lt;br&gt;RCA + chat (in Lambda / Fargate)&lt;br&gt;&lt;i&gt;next: Bedrock AgentCore Runtime&lt;/i&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1">
          <mxGeometry x="1240" y="330" width="78" height="78" as="geometry" />
        </mxCell>

        <mxCell id="claude" value="&lt;b&gt;Amazon Bedrock&lt;/b&gt;&lt;br&gt;Nova Pro / Claude" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1">
          <mxGeometry x="1480" y="330" width="78" height="78" as="geometry" />
        </mxCell>

        <mxCell id="ddbIncidents" value="&lt;b&gt;Amazon DynamoDB&lt;/b&gt;&lt;br&gt;incidents · operator log" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;align=left;spacingLeft=6;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="1240" y="140" width="78" height="78" as="geometry" />
        </mxCell>

        <!-- Row: control plane -->
        <mxCell id="alb" value="&lt;b&gt;Application&lt;br&gt;Load Balancer&lt;/b&gt;&lt;br&gt;HTTP (add ACM cert for HTTPS)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elastic_load_balancing;" vertex="1" parent="1">
          <mxGeometry x="600" y="620" width="78" height="78" as="geometry" />
        </mxCell>

        <mxCell id="fargate" value="&lt;b&gt;Amazon ECS on Fargate&lt;/b&gt;&lt;br&gt;dashboard · simulator · chat" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;" vertex="1" parent="1">
          <mxGeometry x="830" y="620" width="78" height="78" as="geometry" />
        </mxCell>

        <mxCell id="s3" value="&lt;b&gt;Amazon S3&lt;/b&gt;&lt;br&gt;profiles/*.yaml&lt;br&gt;benchmark results" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1">
          <mxGeometry x="1040" y="620" width="78" height="78" as="geometry" />
        </mxCell>

        <mxCell id="ecr" value="&lt;b&gt;Amazon ECR&lt;/b&gt;&lt;br&gt;app image" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;" vertex="1" parent="1">
          <mxGeometry x="830" y="810" width="78" height="78" as="geometry" />
        </mxCell>

        <mxCell id="cw" value="&lt;b&gt;Amazon CloudWatch&lt;/b&gt;&lt;br&gt;logs · decision latency · $ saved" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1">
          <mxGeometry x="1240" y="620" width="78" height="78" as="geometry" />
        </mxCell>

        <mxCell id="iam" value="&lt;b&gt;AWS IAM&lt;/b&gt;&lt;br&gt;least-privilege roles" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;" vertex="1" parent="1">
          <mxGeometry x="1040" y="810" width="78" height="78" as="geometry" />
        </mxCell>

        <mxCell id="cdk" value="&lt;b&gt;AWS CDK → CloudFormation&lt;/b&gt;&lt;br&gt;all infra as code" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudformation;" vertex="1" parent="1">
          <mxGeometry x="1240" y="810" width="78" height="78" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="&lt;b&gt;Flow&lt;/b&gt;&lt;br&gt;① Simulator publishes alarms + operator log&lt;br&gt;② Edge receives over MQTT (outbound)&lt;br&gt;③ Decider classifies, Router picks route&lt;br&gt;④ Edge publishes decision&lt;br&gt;⑤ Rule: every decision → DynamoDB&lt;br&gt;⑥ Rule: route = escalate → SQS&lt;br&gt;⑦ Lambda groups cascade → invokes agent&lt;br&gt;⑧ Agent asks Bedrock for RCA, saves incident&lt;br&gt;⑨ Dashboard polls DynamoDB every second" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="1395" y="600" width="235" height="190" as="geometry" />
        </mxCell>

        <!-- ===================== EDGES ===================== -->
        <mxCell id="e_agent_decider" value="③ POST /v1/systemone" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=block;startFill=1;endFill=1;strokeColor=#B85450;fontSize=11;" edge="1" parent="1" source="edgeAgent" target="decider">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_iot_to_edge" value="② alarms + oplog&lt;br&gt;MQTT/TLS 8883" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#7AA116;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="iot" target="edgeAgent">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_edge_to_iot" value="④ publish decisions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="edgeAgent" target="iot">
