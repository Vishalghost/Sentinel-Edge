        <mxCell id="e_iot_sqs" value="⑥ Rule: route = escalate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="iot" target="sqs">
