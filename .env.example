# Copy to .env (git- and docker-ignored) and paste your values. Real environment variables override this file.

# Hosted Strands Decider API: leave both empty to use the local GPU server (bash .serve.sh)
STRANDS_DECIDER_URL=
STRANDS_DECIDER_API_KEY=

# Hosted free tier is 10 requests a minute; 9 leaves one for the health check
STRANDS_DECIDER_RPM=9
